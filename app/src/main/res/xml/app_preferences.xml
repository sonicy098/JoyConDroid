<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/feature_settings">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="ENABLED_ACCELEROMETER"
            android:title="@string/enable_accelerometer" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="ENABLED_GYROSCOPE"
            android:title="@string/enable_gyroscope" />
            
        <SeekBarPreference
	        android:key="SENSOR_MULTIPLIER"
	        android:title="Sensor Sensitivity Multiplier"
	        android:summary="Tingkatkan jika Switch Let's Go Pikachu tidak mendeteksi ayunan (Default: 1)"
	        android:defaultValue="1"
	        app:min="1"
	        android:max="10" />
	        
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="HAPTIC_FEEDBACK_ENABLED"
            android:title="@string/enable_haptic_feedback" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="ENABLED_AMIIBO"
            android:title="@string/enable_amiibo" />

        <Preference
            android:key="amiibo_file"
            android:title="@string/amiibo_bin_path" />

        <SeekBarPreference
            android:defaultValue="15"
            android:key="PACKET_RATE"
            android:max="120"
            android:title="@string/packet_rate_title"
            app:min="1"
            app:showSeekBarValue="true" />

    </PreferenceCategory>
    
    <PreferenceCategory android:title="Pengaturan Getaran Gamepad">

        <SwitchPreferenceCompat
            android:key="route_vibration_to_gamepad"
            android:title="Teruskan Getaran ke Gamepad USB/OTG"
            android:summary="Matikan getaran HP dan teruskan sinyal rumble ke stik eksternal"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="vibration_is_stereo"
            android:title="Mode Getaran Stereo"
            android:summary="Pisahkan getaran motor kiri dan kanan"
            android:defaultValue="true" />

        <!-- ================= GRUP MONO ================= -->
        <SeekBarPreference
            android:key="vibration_multiplier"
            android:title="Pengali Kekuatan Mono"
            android:summary="Tingkatkan kekuatan getaran (Default: 10 = 1.0x)"
            android:defaultValue="10"
            android:max="30" 
            app:min="0" /> 
        <Preference
            android:key="test_vibration_mono"
            android:title="Uji Getaran Mono"
            android:summary="Ketuk untuk mengetes efek getaran" />

        <!-- ================ GRUP STEREO ================ -->
        <SwitchPreferenceCompat
            android:key="vibrator_swap_motors"
            android:title="Tukar Posisi Motor Kiri/Kanan"
            android:summary="Gunakan jika posisi getaran berat dan ringan terbalik"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="vibrator_left_enabled"
            android:title="Aktifkan Motor Kiri (Berat)"
            android:defaultValue="true" />
        <SeekBarPreference
            android:key="vibration_multiplier_left"
            android:title="Pengali Kekuatan Motor Kiri"
            android:defaultValue="10"
            android:max="30"
            app:min="0" />
        <Preference
            android:key="test_vibration_left"
            android:title="Uji Motor Kiri" />

        <SwitchPreferenceCompat
            android:key="vibrator_right_enabled"
            android:title="Aktifkan Motor Kanan (Ringan)"
            android:defaultValue="true" />
        <SeekBarPreference
            android:key="vibration_multiplier_right"
            android:title="Pengali Kekuatan Motor Kanan"
            android:defaultValue="10"
            android:max="30"
            app:min="0" />
        <Preference
            android:key="test_vibration_right"
            android:title="Uji Motor Kanan" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/color_settings">

        <Preference
            android:key="left_joycon_body_color"
            android:title="@string/left_joycon_body_color" />

        <Preference
            android:key="left_joycon_button_color"
            android:title="@string/left_joycon_button_color" />

        <Preference
            android:key="right_joycon_body_color"
            android:title="@string/right_joycon_body_color" />

        <Preference
            android:key="right_joycon_button_color"
            android:title="@string/right_joycon_button_color" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/device_settings">

        <EditTextPreference
            android:dialogTitle="@string/set_bt_address"
            android:key="BT_ADDRESS"
            android:title="@string/mac_address"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:key="DEVICE_NAME"
            android:title="@string/device_name" />

    </PreferenceCategory>

</PreferenceScreen>
